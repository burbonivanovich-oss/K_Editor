{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(node scripts/*)",
      "Bash(npm test*)",
      "Bash(npm run *)",
      "Bash(node --test*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git branch*)",
      "Bash(git stash*)",
      "Bash(git ls-files*)",
      "Bash(gh pr *)",
      "Bash(gh run *)",
      "Bash(gh workflow *)",
      "Bash(gh issue *)",
      "Bash(ls*)",
      "Bash(mkdir -p .claude/*)",
      "Bash(mkdir -p src/*)",
      "Bash(mkdir -p docs/*)",
      "Bash(find scripts *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(wc *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Read",
      "Glob",
      "Grep",
      "Edit(src/**)",
      "Edit(scripts/**)",
      "Edit(docs/**)",
      "Edit(.claude/**)",
      "Edit(*.md)",
      "WebSearch",
      "WebFetch(domain:kontur.ru)",
      "WebFetch(domain:publication.pravo.gov.ru)",
      "WebFetch(domain:pravo.gov.ru)",
      "WebFetch(domain:consultant.ru)",
      "WebFetch(domain:garant.ru)",
      "WebFetch(domain:base.garant.ru)",
      "WebFetch(domain:nalog.gov.ru)",
      "WebFetch(domain:honestsign.ru)",
      "WebFetch(domain:crpt.ru)",
      "WebFetch(domain:normativ.kontur.ru)",
      "WebFetch(domain:support.kontur.ru)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(cat .env*)",
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(gh secret *)",
      "Bash(gh auth *)",
      "Bash(git push*)"
    ]
  }
}
